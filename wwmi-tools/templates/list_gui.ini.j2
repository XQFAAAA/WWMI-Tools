namespace = {{ namespace }}

{% set button_count = list_gui_objects | length %}
{% set switch_count = menu_switches | length if menu_switches else 0 %}
{% set total_buttons = button_count + switch_count %}
{% set switch_max_pool = (menu_switches | map(attribute='pool_size') | max) if menu_switches else 0 %}
[Constants]

global $menu
global $mouse_clicked
global $mouse_hold
global $mouse_press_in_header = 0
global $mouse_press_in_list = 0
global $is_dragging
global $drag_start_x = 0
global $drag_start_y = 0
global persist $final_x_off = -1
global persist $final_y_off = 0.05845
global $press_effect = 0.002
global $res_width = 0
global $res_height = 0

global $Button_is_hover
global $Button_active = 0
global $Button_number = 0
global $Button_x = 0
global $Button_y = 0

global $UI_x_size = 0
global $UI_y_size = 0

; 按钮按下延迟触发
global $is_button_pressed = 0
global $button_press_x = 0
global $button_press_y = 0
global $button_pressed_number = 0

; 滚动系统
global $scroll_offset = 0
global $is_scrolling = 0
global $scroll_start_y = 0
global $list_viewport_height = 600
global $list_viewport_y_size = 0
global $total_list_y_size = 0
global $list_top_y = 0
global $list_bottom_y = 0

; 元素素宽度（固定归一化值）
global $Element_x_size = 0
global $Element_norm_width = 0.1875
global $Element_width = 720

; 图片实际像素高度（由导出时传递）
global $Hearder_y_size = 0
global $Hearder_height = {{ header_height }}

global $Footer_y_size = 0
global $Footer_height = {{ footer_height }}

global $Button_y_size = 0
global $Button_height = {{ button_height }}

global $UI_Gap = 0.0045

global $Button_amount = {{ total_buttons }}

; 左侧功能图标（Reload / Save / State1-3）
global $Icon_x_size = 0
global $Icon_y_size = 0
global $Icon_x = 0
global $Icon_y = 0
global $Icon_start_y = 0
global $Icon_column_height = 0
global $Icon_amount = 5
; 侧边按钮（图标栏/通道按钮）的基准高度像素，可调小以缩小侧边按钮
global $Icon_height = 64
global $Icon_gap_x = 0.006
global $Icon_gap_y = 0.006
global $Icon_number = 0
global $Icon_is_hover = 0

; 当前选中的状态槽（1/2/3=对应 State，互斥高亮），初始化默认高亮 State1
global $selected_state = 1

; 图标按下延迟触发
global $is_icon_pressed = 0
global $icon_press_x = 0
global $icon_press_y = 0
global $icon_pressed_number = 0

{% if menu_switches %}
; 菜单切换节点（有几个切换节点就有几个列表项与对应 pool）
global $Switch_amount = {{ switch_count }}
; 当前激活显示的菜单切换列表项（0=无，1/2/...=对应切换节点），互斥
global $active_switch = 0

; 各菜单切换节点的贴图数量（即对应 pool 大小）
{%- for sw in menu_switches %}
global $Switch{{ loop.index0 }}_pool_size = {{ sw.pool_size }}
{%- endfor %}

; 左侧贴图框（竖向排列，宽为固定归一化数值，高=宽）
global $TexFrame_x_size = 0
global $TexFrame_y_size = 0
global $TexFrame_x = 0
global $TexFrame_y = 0
global $TexFrame_start_y = 0
global $TexFrame_gap = 0.006
global $TexFrame_number = 0
global $TexFrame_index = 0
global $TexFrame_max_amount = {{ switch_max_pool }}
global $TexFrame_is_hover = 0
; 贴图框 Border：正方形资源描边占图宽比例（8px/480px=1/60），描边从框边界向内绘制，贴图内缩一个描边宽使其被描边包裹
global $TexFrame_stroke = 0.0166667

; 贴图框按下延迟触发
global $is_texframe_pressed = 0
global $texframe_press_x = 0
global $texframe_press_y = 0
global $texframe_pressed_number = 0

; 贴图列滚动（独立于列表项，竖向显示范围与列表项一致）
global $TexFrame_scroll_offset = 0
global $is_texframe_scrolling = 0
global $texframe_scroll_start_y = 0
global $TexFrame_total_height = 0
global $mouse_press_in_texframes = 0

; 各切换节点当前选中的贴图索引（即对应 pool 的索引，持久化）
{%- for sw in menu_switches %}
global persist $textures_{{ sw.identifier | lower }}_index = 0
{%- endfor %}

; 贴图预览通道模式按钮（仅贴图列出现时显示，互斥高亮）
; 0=RGB+Alpha 1=RGB 2=Alpha 3=R 4=G 5=B
global persist $texture_channel = 0
global $Channel_amount = 6
global $Channel_x_size = 0
global $Channel_y_size = 0
global $Channel_x = 0
global $Channel_y = 0
global $Channel_start_y = 0
global $Channel_gap_x = 0.006
global $Channel_gap_y = 0.006
global $ChannelButton_number = 0
global $ChannelButton_is_hover = 0

; 通道按钮按下延迟触发
global $is_channel_pressed = 0
global $channel_press_x = 0
global $channel_press_y = 0
global $channel_pressed_number = 0
{% endif %}

run = CommandListInitPool

[CommandListInitPool]
{%- for pool_idx in range(4) %}
{%- for obj in list_gui_objects %}
$PoolMeshState{{ pool_idx }}[{{ loop.index0 }}] = {{ obj.draw_var }}
{%- endfor %}
{%- for sw in menu_switches %}
$PoolMeshState{{ pool_idx }}[{{ button_count + loop.index0 }}] = $textures_{{ sw.identifier | lower }}_index
{%- endfor %}
{%- endfor %}

{%- for sw in menu_switches %}
{%- for input in sw.inputs %}
PoolTextures{{ sw.identifier }}[{{ loop.index0 }}] = ref ResourceTexture{{ input }}
{%- endfor %}
{%- endfor %}
{% if menu_switches %}
; 按持久化的索引重新指向切换资源（mod.ini 默认只指向第一个连接）
{%- for sw in menu_switches %}
ResourceTexture{{ sw.identifier }} = ref PoolTextures{{ sw.identifier }}[$textures_{{ sw.identifier | lower }}_index]
{%- endfor %}
{% endif %}

[PoolMeshState0]
pool_size = {{ total_buttons }}
pool_index_type = ring
pool_persist_variables = 1

[PoolMeshState1]
pool_size = {{ total_buttons }}
pool_index_type = ring
pool_persist_variables = 1

[PoolMeshState2]
pool_size = {{ total_buttons }}
pool_index_type = ring
pool_persist_variables = 1

[PoolMeshState3]
pool_size = {{ total_buttons }}
pool_index_type = ring
pool_persist_variables = 1

{% for sw in menu_switches %}
[PoolTextures{{ sw.identifier }}]
pool_size = {{ sw.pool_size }}
pool_index_type = ring

{% endfor %}

[KeyToggleUI]
condition = $object_detected
key = 0
type = cycle
$menu = 0,1

[KeyMouse]
condition = $menu
key = VK_LBUTTON
type = hold
$mouse_clicked = 1
$mouse_hold = 1

[KeyMouseRB]
condition = $menu
key = VK_RBUTTON
type = hold
run = CommandListResetUIPosition

[CommandListResetUIPosition]
$final_x_off = 0.9 - $UI_x_size
$final_y_off = 0.5 - $UI_y_size/2

[Present]
if $menu && $object_detected
    run = CommandListPassWindowInfo
    run = CommandListPassConstants

    ; 默认 tint 白色，按钮会覆盖
    x88 = 1
    y88 = 1
    z88 = 1
    w88 = 1

    ; 默认裁剪区域全屏，按钮绘制时覆盖
    x89 = 0
    y89 = 1

    run = CommandListDrawUIElement
    run = CommandListDrawUIHeader
    run = CommandListDrawUIFooter

{%- for obj in list_gui_objects %}
    run = CommandListAddButton
{%- endfor %}
{%- for sw in menu_switches %}
    run = CommandListAddButton
{%- endfor %}
    $Button_number = 0

    ; 左侧功能图标栏
    run = CommandListAddIcon
    run = CommandListAddIcon
    run = CommandListAddIcon
    run = CommandListAddIcon
    run = CommandListAddIcon
    $Icon_number = 0

{% if menu_switches %}
    ; 菜单切换贴图列（仅激活的切换节点显示）
{% for _ in range(switch_max_pool) %}
    run = CommandListAddTexFrame
{% endfor %}
    $TexFrame_number = 0

    ; 贴图预览通道模式按钮（仅贴图列出现时显示，互斥高亮）
    if $active_switch != 0
        run = CommandListAddChannelButton
        run = CommandListAddChannelButton
        run = CommandListAddChannelButton
        run = CommandListAddChannelButton
        run = CommandListAddChannelButton
        run = CommandListAddChannelButton
        $ChannelButton_number = 0
    endif
{% endif %}

    run = CommandListCheckMouse
endif

[CommandListPassWindowInfo]
$res_width = res_width
$res_height = res_height

[CommandListPassConstants]
; 固定归一化宽度 0.1875，高度 = 宽度 * 屏幕比例 * 图片比例
$Element_x_size = $Element_norm_width
$Hearder_y_size = $Element_x_size * (res_width / res_height) * ($Hearder_height / $Element_width)
$Footer_y_size = $Element_x_size * (res_width / res_height) * ($Footer_height / $Element_width)
$Button_y_size = $Element_x_size * (res_width / res_height) * ($Button_height / $Element_width)

; UI 总宽度 = 元素宽度
$UI_x_size = $Element_x_size

; 列表视口高度（固定像素 → 归一化）
$list_viewport_y_size = $list_viewport_height / $res_height

; 整个按钮列表的总高度（归一化）
$total_list_y_size = ($Button_y_size + $UI_Gap * res_width / res_height) * $Button_amount + $UI_Gap * res_width / res_height

; UI 高度 = 头部 + 视口 + 尾部
$UI_y_size = $Hearder_y_size + $list_viewport_y_size + $Footer_y_size

; 滚动偏移钳制
if $scroll_offset < 0
    $scroll_offset = 0
endif
if $total_list_y_size > $list_viewport_y_size
    if $scroll_offset > $total_list_y_size - $list_viewport_y_size
        $scroll_offset = $total_list_y_size - $list_viewport_y_size
    endif
else
    $scroll_offset = 0
endif

; 列表区域边界
$list_top_y = $final_y_off + $Hearder_y_size
$list_bottom_y = $list_top_y + $list_viewport_y_size

if $final_x_off == -1
    $final_x_off = 0.5 - $UI_x_size / 2
endif

; 左侧图标栏布局（贴合面板左缘，起始高度与通道按钮/贴图列一致）
$Icon_x_size = $Element_x_size * ($Icon_height / $Element_width)
$Icon_y_size = $Icon_x_size * (res_width / res_height)
$Icon_column_height = $Icon_amount * $Icon_y_size + ($Icon_amount - 1) * $Icon_gap_y
$Icon_start_y = $list_top_y + $UI_Gap * (res_width / res_height)
$Icon_x = $final_x_off - $Icon_gap_x - $Icon_x_size

; 贴图框布局（宽为固定归一化数值 0.125，高=宽，竖向排列于图标栏左侧）
$TexFrame_x_size = 0.125
$TexFrame_y_size = $TexFrame_x_size * (res_width / res_height)
; 起始位置预留与按钮列表项相同的上下边距，避免最上/最下贴图贴住显示边
$TexFrame_start_y = $list_top_y + $UI_Gap * (res_width / res_height)
$TexFrame_x = $Icon_x - $TexFrame_gap - $TexFrame_x_size

; 贴图列总高度（竖向排列，支持拖动滚动，显示范围与列表项一致）
$TexFrame_total_height = ($TexFrame_y_size + $TexFrame_gap * (res_width / res_height)) * $TexFrame_max_amount + $TexFrame_gap * (res_width / res_height)
if $TexFrame_scroll_offset < 0
    $TexFrame_scroll_offset = 0
endif
if $TexFrame_total_height > $list_viewport_y_size
    if $TexFrame_scroll_offset > $TexFrame_total_height - $list_viewport_y_size
        $TexFrame_scroll_offset = $TexFrame_total_height - $list_viewport_y_size
    endif
else
    $TexFrame_scroll_offset = 0
endif

; 通道按钮列（位于贴图列左侧，尺寸同左侧图标，竖向排列）
$Channel_x_size = $Icon_x_size
$Channel_y_size = $Icon_y_size
$Channel_start_y = $TexFrame_start_y
$Channel_x = $TexFrame_x - $Channel_gap_x - $Channel_x_size

[CommandListSetButtonCondition]
{%- for obj in list_gui_objects %}
{%- set btn_num = loop.index %}
{%- if btn_num == 1 %}
if $Button_number == {{ btn_num }}
{%- else %}
else if $Button_number == {{ btn_num }}
{%- endif %}
    {{ obj.draw_var }} = 1 - {{ obj.draw_var }}
{%- for other in obj.exclusive_others %}
    {{ other }} = 0
{%- endfor %}
{%- endfor %}
{%- for sw in menu_switches %}
{%- set btn_num = button_count + loop.index %}
{%- set sw_num = loop.index %}
else if $Button_number == {{ btn_num }}
    ; {{ sw.display_name }} 列表项：激活/关闭贴图列（互斥）
    if $active_switch == {{ sw_num }}
        $active_switch = 0
    else
        $active_switch = {{ sw_num }}
        $TexFrame_scroll_offset = 0
    endif
{%- endfor %}
endif

[CommandListSetButtonActive]
$Button_active = 0
{%- for obj in list_gui_objects %}
{%- set btn_num = loop.index %}
{%- set var_name = obj.draw_var %}
{%- if btn_num == 1 %}
if $Button_number == {{ btn_num }}
{%- else %}
else if $Button_number == {{ btn_num }}
{%- endif %}
    if {{ var_name }}
        $Button_active = 1
    endif
{%- endfor %}
{%- for sw in menu_switches %}
{%- set btn_num = button_count + loop.index %}
{%- set sw_num = loop.index %}
else if $Button_number == {{ btn_num }}
    if $active_switch == {{ sw_num }}
        $Button_active = 1
    endif
{%- endfor %}
endif

[CommandListSetButtonIcon]
{%- for obj in list_gui_objects %}
{%- set btn_num = loop.index %}
{%- if btn_num == 1 %}
if $Button_number == {{ btn_num }}
{%- else %}
else if $Button_number == {{ btn_num }}
{%- endif %}
    ps-t100 = ResourceButton_Icon{{ btn_num }}
{%- endfor %}
{%- for sw in menu_switches %}
{%- set btn_num = button_count + loop.index %}
else if $Button_number == {{ btn_num }}
    ps-t100 = ResourceButton_Icon{{ btn_num }}
{%- endfor %}
endif

[CommandListAddButton]
$Button_number = $Button_number + 1
if $Button_number <= $Button_amount
    run = CommandListButtonPosition
    run = CommandListCheckButtonHover
    run = CommandListDrawButton
endif

[CommandListButtonPosition]
$Button_x = $final_x_off
$Button_y = $final_y_off + $Hearder_y_size + ($Button_y_size + $UI_Gap * res_width / res_height) * ($Button_number - 1) + $UI_Gap * res_width / res_height - $scroll_offset

[CommandListCheckButtonHover]
$Button_is_hover = 0
if $Button_y + $Button_y_size > $list_top_y + $UI_Gap && $Button_y < $list_bottom_y - $UI_Gap
    if cursor_y > $Button_y && cursor_y < $Button_y + $Button_y_size
        if cursor_x > $Button_x && cursor_x < $Button_x + $Element_x_size
            $Button_is_hover = 1
            if $mouse_clicked && !$is_button_pressed && !$is_scrolling
                $is_button_pressed = 1
                $button_press_x = cursor_x
                $button_press_y = cursor_y
                $button_pressed_number = $Button_number
            endif
        endif
    endif
endif

[CommandListCheckMouse]
; Track where mouse was first pressed down (check before clearing click event)
if $mouse_clicked
    if cursor_x > $final_x_off && cursor_x < $final_x_off + $UI_x_size
        if cursor_y > $final_y_off && cursor_y < $final_y_off + $Hearder_y_size
            $mouse_press_in_header = 1
        else if cursor_y > $list_top_y && cursor_y < $list_bottom_y
            $mouse_press_in_list = 1
        endif
    endif
    ; 贴图列区域按下（用于拖动滚动）
    if cursor_x > $TexFrame_x && cursor_x < $TexFrame_x + $TexFrame_x_size
        if cursor_y > $list_top_y && cursor_y < $list_bottom_y
            $mouse_press_in_texframes = 1
        endif
    endif
endif
; Reset click event
$mouse_clicked = 0
; Reset press flags on release
if !$mouse_hold
    $mouse_press_in_header = 0
    $mouse_press_in_list = 0
    $is_scrolling = 0
    $mouse_press_in_texframes = 0
    $is_texframe_scrolling = 0
endif

; 按钮按下延迟触发：按住不动→等待，移动→滚动，释放→触发
if $is_button_pressed
    if $mouse_hold
        if cursor_x != $button_press_x || cursor_y != $button_press_y
            $is_button_pressed = 0
            $is_scrolling = 1
            $scroll_start_y = cursor_y
            $mouse_press_in_list = 1
        endif
    else
        $Button_number = $button_pressed_number
        run = CommandListSetButtonCondition
        $Button_number = 0
        $is_button_pressed = 0
    endif
else if $is_icon_pressed
    ; 图标按下延迟触发：按住不动→释放时触发，移动→取消
    if $mouse_hold
        if cursor_x != $icon_press_x || cursor_y != $icon_press_y
            $is_icon_pressed = 0
        endif
    else
        $Icon_number = $icon_pressed_number
        run = CommandListIconAction
        $Icon_number = 0
        $is_icon_pressed = 0
    endif
else if $is_channel_pressed
    ; 通道按钮按下延迟触发：按住不动→释放时切换通道，移动→取消
    if $mouse_hold
        if cursor_x != $channel_press_x || cursor_y != $channel_press_y
            $is_channel_pressed = 0
        endif
    else
        $ChannelButton_number = $channel_pressed_number
        run = CommandListChannelButtonAction
        $ChannelButton_number = 0
        $is_channel_pressed = 0
    endif
else if $is_texframe_pressed
    ; 贴图框按下：按住不动→释放时选中贴图，移动→滚动贴图列
    if $mouse_hold
        if cursor_x != $texframe_press_x || cursor_y != $texframe_press_y
            $is_texframe_pressed = 0
            $is_texframe_scrolling = 1
            $texframe_scroll_start_y = cursor_y
        endif
    else
        $TexFrame_number = $texframe_pressed_number
        run = CommandListTexFrameAction
        $TexFrame_number = 0
        $is_texframe_pressed = 0
    endif
else if $is_texframe_scrolling
    if $mouse_hold
        run = CommandListTexFrameScroll
    else
        $is_texframe_scrolling = 0
    endif
else if $is_dragging == 1
    if $mouse_hold
        run = CommandListMoveUIElement
    else
        $is_dragging = 0
    endif
else if $mouse_press_in_header
    ; 头部区域拖拽 UI 窗口
    if $mouse_hold
        run = CommandListStartDrag
        run = CommandListMoveUIElement
        $is_scrolling = 0
    else
        $is_dragging = 0
    endif
else if $mouse_press_in_texframes
    ; 贴图列区域拖动滚动
    if $mouse_hold
        run = CommandListTexFrameScroll
    else
        $is_texframe_scrolling = 0
    endif
else if $mouse_press_in_list
    ; 列表区域滚动
    if $mouse_hold && !$Button_is_hover
        run = CommandListScroll
    else
        $is_scrolling = 0
    endif
endif

[CommandListDrawButton]
if $Button_y + $Button_y_size > $list_top_y + $UI_Gap && $Button_y < $list_bottom_y - $UI_Gap
x87 = $Element_x_size
y87 = $Button_y_size
z87 = $Button_x
w87 = $Button_y

; 裁剪区域
x89 = $list_top_y + $UI_Gap
y89 = $list_bottom_y - $UI_Gap

; 1. 背景 - 不 tint（保持默认白色，显示原始 0.5 黑色）
ps-t100 = ResourceButtonBg
run = CustomShaderElement

; 2. 设置边框和文本的颜色 tint
run = CommandListSetButtonActive
if $Button_is_hover
    x88 = 1
    y88 = 1
    z88 = 1
    w88 = 1
else if $Button_active
    x88 = 0.882
    y88 = 0.843
    z88 = 0.6
    w88 = 1
else
    x88 = 0.6745
    y88 = 0.7294
    z88 = 0.7333
    w88 = 1
endif

; 边框
ps-t100 = ResourceButtonBorder
run = CustomShaderElement

; 文本
run = CommandListSetButtonIcon
run = CustomShaderElement
endif

[CommandListDrawUIElement]
x87 = $UI_x_size
y87 = $UI_y_size
z87 = $final_x_off
w87 = $final_y_off
ps-t100 = ResourceUIBackground
run = CustomShaderElement

[CommandListDrawUIHeader]
x87 = $Element_x_size
y87 = $Hearder_y_size
z87 = $final_x_off
w87 = $final_y_off
ps-t100 = ResourceUIHeader
run = CustomShaderElement

[CommandListDrawUIFooter]
x87 = $Element_x_size
y87 = $Footer_y_size
z87 = $final_x_off
w87 = $final_y_off + $UI_y_size - $Footer_y_size
ps-t100 = ResourceUIFooter
run = CustomShaderElement

[CommandListStartDrag]
if $is_dragging == 0
    $drag_start_x = cursor_x - $final_x_off
    $drag_start_y = cursor_y - $final_y_off
    $is_dragging = 1
endif

[CommandListMoveUIElement]
if $is_dragging == 1
    if $mouse_hold
        $final_x_off = cursor_x - $drag_start_x
        $final_y_off = cursor_y - $drag_start_y

        if $final_x_off < 0
            $final_x_off = 0
        endif
        if $final_x_off > 1 - $UI_x_size
            $final_x_off = 1 - $UI_x_size
        endif

        if $final_y_off < 0
            $final_y_off = 0
        endif
        if $final_y_off > 1 - $UI_y_size
            $final_y_off = 1 - $UI_y_size
        endif
    else
        $is_dragging = 0
    endif
endif

[CommandListScroll]
if $is_scrolling == 0
    $scroll_start_y = cursor_y
    $is_scrolling = 1
else
    $scroll_offset = $scroll_offset + $scroll_start_y - cursor_y
    $scroll_start_y = cursor_y
endif

[CommandListAddTexFrame]
$TexFrame_number = $TexFrame_number + 1
$TexFrame_index = $TexFrame_number - 1
if $TexFrame_number <= $TexFrame_max_amount
    $TexFrame_y = $TexFrame_start_y + ($TexFrame_y_size + $TexFrame_gap * (res_width / res_height)) * $TexFrame_index - $TexFrame_scroll_offset
    if $TexFrame_y + $TexFrame_y_size > $list_top_y + $UI_Gap && $TexFrame_y < $list_bottom_y - $UI_Gap
{%- if menu_switches %}
{%- for sw in menu_switches %}
{%- set sw_num = loop.index %}
{%- if sw_num == 1 %}
        if $active_switch == {{ sw_num }}
{%- else %}
        else if $active_switch == {{ sw_num }}
{%- endif %}
            if $TexFrame_number <= $Switch{{ loop.index0 }}_pool_size
                run = CommandListCheckTexFrameHover
                run = CommandListDrawTexFrame
            endif
{%- endfor %}
        endif
{%- endif %}
    endif
endif

[CommandListCheckTexFrameHover]
$TexFrame_is_hover = 0
if cursor_x > $TexFrame_x && cursor_x < $TexFrame_x + $TexFrame_x_size
    if cursor_y > $TexFrame_y && cursor_y < $TexFrame_y + $TexFrame_y_size
        $TexFrame_is_hover = 1
        if $mouse_clicked && !$is_texframe_pressed && !$is_button_pressed && !$is_icon_pressed && !$is_scrolling && !$is_texframe_scrolling
            $is_texframe_pressed = 1
            $texframe_press_x = cursor_x
            $texframe_press_y = cursor_y
            $texframe_pressed_number = $TexFrame_number
        endif
    endif
endif

[CommandListDrawTexFrame]
; 裁剪区域：与列表项相同的竖向显示范围
x89 = $list_top_y + $UI_Gap
y89 = $list_bottom_y - $UI_Gap

; 1. 贴图（内缩一个描边宽：描边从框边界向内绘制，内缩后描边刚好包裹在贴图外围而非压在贴图内部；使用专用着色器，颜色随通道模式显示）
x87 = $TexFrame_x_size * (1 - 2 * $TexFrame_stroke)
y87 = $TexFrame_y_size * (1 - 2 * $TexFrame_stroke)
z87 = $TexFrame_x + $TexFrame_x_size * $TexFrame_stroke
w87 = $TexFrame_y + $TexFrame_y_size * $TexFrame_stroke
x90 = $texture_channel
{%- if menu_switches %}
{%- for sw in menu_switches %}
{%- set sw_num = loop.index %}
{%- if sw_num == 1 %}
if $active_switch == {{ sw_num }}
{%- else %}
else if $active_switch == {{ sw_num }}
{%- endif %}
    ps-t100 = ref PoolTextures{{ sw.identifier }}[$TexFrame_index]
{%- endfor %}
endif
{%- endif %}
run = CustomShaderElementTexture

; 2. 贴图框 Border（画在框边界，描边自然落在内缩贴图的外围；独立正方形资源，无圆角；悬停/选中/未选中效果同列表项）
x87 = $TexFrame_x_size
y87 = $TexFrame_y_size
z87 = $TexFrame_x
w87 = $TexFrame_y
run = CommandListSetTexFrameTint
ps-t100 = ResourceTexFrameBorder
run = CustomShaderElement

[CommandListSetTexFrameTint]
if $TexFrame_is_hover
    x88 = 1
    y88 = 1
    z88 = 1
    w88 = 1
{%- if menu_switches %}
{%- for sw in menu_switches %}
{%- set sw_num = loop.index %}
else if $active_switch == {{ sw_num }} && $textures_{{ sw.identifier | lower }}_index == $TexFrame_index
    x88 = 0.882
    y88 = 0.843
    z88 = 0.6
    w88 = 1
{%- endfor %}
{%- endif %}
else
    x88 = 0.6745
    y88 = 0.7294
    z88 = 0.7333
    w88 = 1
endif

[CommandListTexFrameAction]
{%- if menu_switches %}
{%- for sw in menu_switches %}
{%- set sw_num = loop.index %}
{%- if sw_num == 1 %}
if $active_switch == {{ sw_num }}
{%- else %}
else if $active_switch == {{ sw_num }}
{%- endif %}
    if $TexFrame_number <= $Switch{{ loop.index0 }}_pool_size
        $textures_{{ sw.identifier | lower }}_index = $TexFrame_number - 1
        ResourceTexture{{ sw.identifier }} = ref PoolTextures{{ sw.identifier }}[$textures_{{ sw.identifier | lower }}_index]
    endif
{%- endfor %}
endif
{%- endif %}

[CommandListTexFrameScroll]
if $is_texframe_scrolling == 0
    $texframe_scroll_start_y = cursor_y
    $is_texframe_scrolling = 1
else
    $TexFrame_scroll_offset = $TexFrame_scroll_offset + $texframe_scroll_start_y - cursor_y
    $texframe_scroll_start_y = cursor_y
endif

[CommandListAddChannelButton]
$ChannelButton_number = $ChannelButton_number + 1
if $ChannelButton_number <= $Channel_amount
    $Channel_y = $Channel_start_y + ($Channel_y_size + $Channel_gap_y) * ($ChannelButton_number - 1)
    run = CommandListCheckChannelButtonHover
    run = CommandListDrawChannelButton
endif

[CommandListCheckChannelButtonHover]
$ChannelButton_is_hover = 0
if cursor_x > $Channel_x && cursor_x < $Channel_x + $Channel_x_size
    if cursor_y > $Channel_y && cursor_y < $Channel_y + $Channel_y_size
        $ChannelButton_is_hover = 1
        if $mouse_clicked && !$is_channel_pressed && !$is_button_pressed && !$is_icon_pressed && !$is_texframe_pressed && !$is_scrolling
            $is_channel_pressed = 1
            $channel_press_x = cursor_x
            $channel_press_y = cursor_y
            $channel_pressed_number = $ChannelButton_number
        endif
    endif
endif

[CommandListDrawChannelButton]
; 裁剪区域恢复全屏（按钮绘制时改过）
x89 = 0
y89 = 1

x87 = $Channel_x_size
y87 = $Channel_y_size
z87 = $Channel_x
w87 = $Channel_y

run = CommandListSetChannelButtonTint
run = CommandListSetChannelButtonTexture
run = CustomShaderElement

[CommandListSetChannelButtonTint]
if $ChannelButton_is_hover
    x88 = 1
    y88 = 1
    z88 = 1
    w88 = 1
else if $ChannelButton_number == 1 && $texture_channel == 0
    x88 = 0.882
    y88 = 0.843
    z88 = 0.6
    w88 = 1
else if $ChannelButton_number == 2 && $texture_channel == 1
    x88 = 0.882
    y88 = 0.843
    z88 = 0.6
    w88 = 1
else if $ChannelButton_number == 3 && $texture_channel == 2
    x88 = 0.882
    y88 = 0.843
    z88 = 0.6
    w88 = 1
else if $ChannelButton_number == 4 && $texture_channel == 3
    x88 = 0.882
    y88 = 0.843
    z88 = 0.6
    w88 = 1
else if $ChannelButton_number == 5 && $texture_channel == 4
    x88 = 0.882
    y88 = 0.843
    z88 = 0.6
    w88 = 1
else if $ChannelButton_number == 6 && $texture_channel == 5
    x88 = 0.882
    y88 = 0.843
    z88 = 0.6
    w88 = 1
else
    x88 = 0.6745
    y88 = 0.7294
    z88 = 0.7333
    w88 = 1
endif

[CommandListSetChannelButtonTexture]
if $ChannelButton_number == 1
    ps-t100 = ResourceChannelRGBAlpha
else if $ChannelButton_number == 2
    ps-t100 = ResourceChannelRGB
else if $ChannelButton_number == 3
    ps-t100 = ResourceChannelAlpha
else if $ChannelButton_number == 4
    ps-t100 = ResourceChannelR
else if $ChannelButton_number == 5
    ps-t100 = ResourceChannelG
else if $ChannelButton_number == 6
    ps-t100 = ResourceChannelB
endif

[CommandListChannelButtonAction]
if $ChannelButton_number == 1
    $texture_channel = 0
else if $ChannelButton_number == 2
    $texture_channel = 1
else if $ChannelButton_number == 3
    $texture_channel = 2
else if $ChannelButton_number == 4
    $texture_channel = 3
else if $ChannelButton_number == 5
    $texture_channel = 4
else if $ChannelButton_number == 6
    $texture_channel = 5
endif

[CommandListAddIcon]
$Icon_number = $Icon_number + 1
if $Icon_number <= $Icon_amount
    $Icon_y = $Icon_start_y + ($Icon_y_size + $Icon_gap_y) * ($Icon_number - 1)
    run = CommandListCheckIconHover
    run = CommandListDrawIcon
endif

[CommandListCheckIconHover]
$Icon_is_hover = 0
if cursor_x > $Icon_x && cursor_x < $Icon_x + $Icon_x_size
    if cursor_y > $Icon_y && cursor_y < $Icon_y + $Icon_y_size
        $Icon_is_hover = 1
        if $mouse_clicked && !$is_icon_pressed && !$is_button_pressed && !$is_scrolling
            $is_icon_pressed = 1
            $icon_press_x = cursor_x
            $icon_press_y = cursor_y
            $icon_pressed_number = $Icon_number
        endif
    endif
endif

[CommandListDrawIcon]
; 裁剪区域恢复全屏（按钮绘制时改过）
x89 = 0
y89 = 1

x87 = $Icon_x_size
y87 = $Icon_y_size
z87 = $Icon_x
w87 = $Icon_y

run = CommandListSetIconTint
run = CommandListSetIconTexture
run = CustomShaderElement

[CommandListSetIconTint]
if $Icon_is_hover
    x88 = 1
    y88 = 1
    z88 = 1
    w88 = 1
else if $Icon_number == 3 && $selected_state == 1
    x88 = 0.882
    y88 = 0.843
    z88 = 0.6
    w88 = 1
else if $Icon_number == 4 && $selected_state == 2
    x88 = 0.882
    y88 = 0.843
    z88 = 0.6
    w88 = 1
else if $Icon_number == 5 && $selected_state == 3
    x88 = 0.882
    y88 = 0.843
    z88 = 0.6
    w88 = 1
else
    x88 = 0.6745
    y88 = 0.7294
    z88 = 0.7333
    w88 = 1
endif

[CommandListSetIconTexture]
if $Icon_number == 1
    ps-t100 = ResourceReload
else if $Icon_number == 2
    ps-t100 = ResourceSave
else if $Icon_number == 3
    ps-t100 = ResourceState1
else if $Icon_number == 4
    ps-t100 = ResourceState2
else if $Icon_number == 5
    ps-t100 = ResourceState3
endif

[CommandListIconAction]
if $Icon_number == 1
    ; Reload：用 PoolMeshState0（加载时快照）恢复 draw 变量，不改变当前高亮状态
    run = CommandListApplyState0
else if $Icon_number == 2
    ; Save：把当前 draw 变量记录到选中的状态槽
    if $selected_state == 1
        run = CommandListSaveState1
    else if $selected_state == 2
        run = CommandListSaveState2
    else if $selected_state == 3
        run = CommandListSaveState3
    endif
else if $Icon_number == 3
    $selected_state = 1
    run = CommandListApplyState1
else if $Icon_number == 4
    $selected_state = 2
    run = CommandListApplyState2
else if $Icon_number == 5
    $selected_state = 3
    run = CommandListApplyState3
endif


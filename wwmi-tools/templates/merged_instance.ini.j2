namespace = {{ namespace }}
; WWMI BETA-8 INI

{%- macro note(text) %}{% if comment_code %}; {{ text }}{% else %};DEL{% endif %}{% endmacro %}

; Mod State -------------------------

{%- if cfg.use_ini_toggles %}
{{note("Hotkeys generated from Ini Toggles")}}
{%- for var in cfg.ini_toggles.vars -%}
{%- if var.hotkeys %}

[KeySwap{{ formatter.format_name_camel_case(var.name) }}]
condition = $object_detected == 1
{%- for hotkeys in formatter.format_hotkeys(var.hotkeys) %}
key = {{ hotkeys }}
{%- endfor %}
type = cycle
{{ formatter.format_ini_swapvar(var.name) }} = {{ var.states | map(attribute='name') | join(', ') }}
{%- endif -%}
{%- endfor %}
{%- endif %}

{{note("Global variables used by entire mod")}}
[Constants]
{{note("Allows WWMI to safely disable incompatible mod and notify user about it")}}
global $required_wwmi_version = {{ '%0.2f'| format(mod_info.required_wwmi_version.as_float()) }}
{{note("Number of indices in original model")}}
global $object_guid = {{ extracted_object.index_count }}
{{note("Number of vertices in custom model")}}
global $mesh_vertex_count = {{ merged_object.vertex_count }}
{{note("Number of shapekeyed vertices in custom model")}}
global $shapekey_vertex_count = {{ merged_object.shapekeys.vertex_count }}
{%- for shapekey_batch in merged_object.shapekeys.batches %}
{{note("ID of the first shapekeyed vertex of this shapekeys batch")}}
global $shapekey_vertex_offset_batch{{ loop.index0 }} = {{ shapekey_batch.vertex_offset }}
{{note("Number of shapekeyed vertices for this shapekeys batch")}}
global $shapekey_vertex_count_batch{{ loop.index0 }} = {{ shapekey_batch.vertex_count }}
{%- endfor %}
{{note("ID assigned to our mod by WWMI")}}
global $mod_id = -1000
{{note("Changes between 0 and 1 with every frame, used to run bone merging only once per frame for every component")}}
global $state_id = 0
{{note("Controls whether our mod is enabled, prevents any overrides from happening if $mod_enabled == 0")}}
{{note("Prevents user from being crash-locked in case of incompatible WWMI version")}}
global $mod_enabled = 0
{{note("Indicates if our object was detected in previous frame")}}
global $object_detected = 0
{{note("Used to pass current merge status to CommandListMergeSkeleton and get resulting merge status")}}
global $merge_status_id = 0
{{note("Stores skeleton merging status of this component per instance for current frame:")}}
{{note("0 - neither regular nor special skeleton bones data was collected for this component")}}
{{note("1 - only regular skeleton bones data was collected for this component")}}
{{note("2 - both regular and special skeleton bones data was collected for this component")}}
{%- for instance in range(cfg.mod_merged_instance_count) %}
{%- for component in extracted_object.components %}
global $merge_status_id_{{ loop.index0 }}_{{ instance }} = 0
{%- endfor %}
{%- endfor %}
{%- if cfg.texture_mode == 'PATH' and cfg.hash_complex and path_complex %}
{%- for component_idx in path_complex.counters %}
{{note("Stores current object index of Component %d being drawn to pick the right texture override" | format(component_idx))}}
global $texture_component{{ component_idx }}_count = -1
{%- endfor %}
{%- endif %}
{%- if cfg.use_ini_toggles %}
; Swap vars aka toggles defaults
{%- for var in cfg.ini_toggles.vars %}
global persist {{ formatter.format_ini_swapvar(var.name) }} = {{ var.default_state or 0 }}
{%- endfor %}
; Per-object state vars
{%- for component in extracted_object.components %}
{%- for obj in merged_object.components[loop.index0].objects %}
global persist {{ formatter.format_ini_drawvar(obj.name) }} = 1
{%- endfor %}
{%- endfor %}
{%- endif %}
{{note("Stores the instance id of the current draw call, captured from the marked Mesh Data CB (see TextureOverrideMeshDataCB)")}}
global $instance_id = 0
{%- for instance in range(cfg.mod_merged_instance_count) %}
{{note("Stores the instance id of instance %d to pick the right pooled skeleton buffers at frame end" | format(instance))}}
global $instance_id_{{ instance }} = 0
{%- endfor %}

{{note("List of commands executed for every frame")}}
[Present]
if $object_detected
    if $mod_enabled
        post $object_detected = 0
        {%- if cfg.use_ini_toggles %}
        run = CommandListProcessToggles
        {%- endif %}
        run = CommandListUpdateMergedSkeleton
    else
        {{note("Check if our mod is compatible with installed WWMI version (runs only once)")}}
        if $mod_id == -1000
            {{note("Pass required WWMI version along with mod metadata to WWMI")}}
            run = CommandListRegisterMod
        endif
    endif
endif

{{note("Contacts WWMI to check whether installed version is compatible with our mod")}}
[CommandListRegisterMod]
{{note("Pass mod info variables to WWMI")}}
$\WWMIv1\required_wwmi_version = $required_wwmi_version
$\WWMIv1\object_guid = $object_guid
{{note("Pass mod info resources to WWMI")}}
Resource\WWMIv1\ModName = ref ResourceModName
Resource\WWMIv1\ModAuthor = ref ResourceModAuthor
Resource\WWMIv1\ModDesc = ref ResourceModDesc
Resource\WWMIv1\ModLink = ref ResourceModLink
Resource\WWMIv1\ModLogo = ref ResourceModLogo
{{note("Register mod in WWMI")}}
run = CommandList\WWMIv1\RegisterMod
{{note("Read mod_id assigned to our mod by WWMI, incompatible mod will get `$mod_id == -1` assigned")}}
$mod_id = $\WWMIv1\mod_id
{{note("Enable our mod if WWMI assigned valid $mod_id to it")}}
if $mod_id >= 0
    $mod_enabled = 1
endif

{%- if cfg.use_ini_toggles %}

{{note("Handles toggles logic")}}
[CommandListProcessToggles]
; Set display of each object according to toggles logic
{%- for object_name, conditions in cfg.ini_toggles.compile_conditions().items() %}
{{ formatter.format_ini_drawvar(object_name) }} = {{ conditions }}
{%- endfor %}
{{note("<< Here's a nice place to put your custom logic that controls objects visibility >>")}}
{%- endif %}

{{note("Copes hard to make merged skeleton work with WuWa 1.1+ pipeline")}}
[CommandListUpdateMergedSkeleton]
{{note("Reset skeleton merge status for all components per instance")}}
{%- for instance in range(cfg.mod_merged_instance_count) %}
{%- for component in extracted_object.components %}
$merge_status_id_{{ loop.index0 }}_{{ instance }} = 0
{%- endfor %}
{%- endfor %}
{{note("Copy skeleton merged in previous frame to new buffer so we could force it to vs-cb4 slot")}}
ResourceMergedSkeleton = copy ResourceMergedSkeletonRW
{{note("Copy extra skeleton merged in previous frame to new buffer so we could force it to vs-cb3 slot")}}
{{note("Yes, skeletons in vs-cb3 and vs-cb4 are slightly different, so we need to merge both for AA and outlines to work correctly")}}
ResourceExtraMergedSkeleton = copy ResourceExtraMergedSkeletonRW
{%- for instance in range(cfg.mod_merged_instance_count) %}
{{note("Copy pooled skeleton of instance %d merged in previous frame so it could be forced to vs-cb slots" | format(instance))}}
PoolMergedSkeleton[$instance_id_{{ instance }}] = copy PoolMergedSkeletonRW[$instance_id_{{ instance }}]
PoolExtraMergedSkeleton[$instance_id_{{ instance }}] = copy PoolExtraMergedSkeletonRW[$instance_id_{{ instance }}]
{%- endfor %}

[ResourceBlendBufferOverride]
[ResourceExtraMergedSkeletonOverride]
[ResourceMergedSkeletonOverride]

; Resources: Mod Info -------------------------

{{note("Name of mod")}}
[ResourceModName]

{%- if mod_info.mod_name.strip() != '' %}
type = Buffer
data = "{{ mod_info.mod_name }}"
{%- else %}
; type = Buffer
; data = "Unknown Mod Name"
{%- endif %}

{{note("Name of mod author")}}
[ResourceModAuthor]
{%- if mod_info.mod_author.strip() != '' %}
type = Buffer
data = "{{ mod_info.mod_author }}"
{%- else %}
; type = Buffer
; data = "Unknown Mod Author"
{%- endif %}

{{note("Mod description")}}
[ResourceModDesc]
{%- if mod_info.mod_desc.strip() != '' %}
type = Buffer
data = "{{ mod_info.mod_desc }}"
{%- else %}
; type = Buffer
; data = "Empty Mod Description"
{%- endif %}

{{note("Link to mod repository")}}
[ResourceModLink]
{%- if mod_info.mod_link.strip() != '' %}
type = Buffer
data = "{{ mod_info.mod_link }}"
{%- else %}
; type = Buffer
; data = "Empty Mod Link"
{%- endif %}

{{note("Texture file with 512x512 .dds (BC7 SRGB) mod logo")}}
[ResourceModLogo]
{%- if mod_info.mod_logo.is_file() %}
filename = Textures/Logo.dds
{%- else %}
; filename = Textures/Logo.dds
{%- endif %}

; Shading: Draw Call Stacks Processing -------------------------

{{note("Marks Bones Data CB resource with arbitrary value 3381.7777")}}
[TextureOverrideMarkBoneDataCB]
hash = {{ extracted_object.cb4_hash }}
match_priority = 0
filter_index = 3381.7777

{{note("Marks Mesh Data CB resource (universal hash 358d62cb) with arbitrary value 3380.7777")}}
{{note("Allows to capture the instance id of the current draw call from vs-cb2/vs-cb3 into $instance_id")}}
[TextureOverrideMeshDataCB]
hash = 358d62cb
match_priority = 0
filter_index = 3380.7777

{{note("Updates merged skeleton buffers with skeleton data of calling component")}}
{{note("The main problem is we can't reliably identify type of skeleton just from the buffer alone since both have the same hash")}}
{{note("Luckily, any relevant shader call within the stack has one of the following slot usage patterns:")}}
{{note("1. Only regular skeleton in vs-cb3")}}
{{note("2. Only regular skeleton in vs-cb4")}}
{{note("3. Special skeleton in vs-cb3 and regular skeleton in vs-cb4")}}
{{note("So by the time we've finished processing the stack we can reliably grab:")}}
{{note("* Regular skeleton from vs-cb4 (pattern 2 or 3), since special skeleton never goes there")}}
{{note("* Special skeleton from vs-cb3 (pattern 3), since we know for sure that regular currently is in vs-cb4")}}
{{note("Since $instance_id records the instance id of the current draw call (captured from the marked Mesh Data CB), each instance merges its own skeleton only once per frame")}}
[CommandListMergeSkeleton]
{{note("Here we're using $merge_status_id as both 'function' input aka argument and return result")}}
{{note("We're doing so to prevent wasting compute resources on job that's already done for current frame")}}
{{note("* $merge_status_id being 0 indicates we haven't merged any skeleton data for calling component in current frame yet")}}
if $merge_status_id == 0
    {{note("Try to get regular skeleton data from current shader call")}}
    {{note("Make sure vs-cb4 contain skeleton data")}}
	if vs-cb4 == 3381.7777
        {{note("Pass constant buffer with regular skeleton data to copy bones from")}}
		cs-cb8 = ref vs-cb4
        {{note("Initialize the pooled skeleton buffer of this instance if it hasn't been initialized yet")}}
        if #PoolMergedSkeletonRW[$instance_id] == -1
            PoolMergedSkeletonRW[$instance_id] = copy ResourceMergedSkeletonRW
        endif
        {%- for instance in range(cfg.mod_merged_instance_count) %}
        {%- if loop.first %}
        if #PoolMergedSkeletonRW[$instance_id] == {{ instance }}
        {%- else %}
        elif #PoolMergedSkeletonRW[$instance_id] == {{ instance }}
        {%- endif %}
            {{note("Remember the instance id of the matched pool slot")}}
            $instance_id_{{ instance }} = $instance_id
            {{note("Pass buffer that gonna store regular skeleton data of all components of this instance")}}
            cs-u6 = ResourceMergedSkeletonRW{{ instance }}
            {{note("Set custom scale for skeleton, changing size of the entire model")}}
            $\WWMIv1\custom_mesh_scale = {{ '%0.2f'| format(skeleton_scale) }}
            {{note("Run Skeleton Merger CS to merge regular skeleton data of current component into this instance's buffer")}}
            run = CustomShader\WWMIv1\SkeletonMerger
            {{note("Associate the merged buffer with the pool slot of this instance")}}
            PoolMergedSkeletonRW[$instance_id] = ref ResourceMergedSkeletonRW{{ instance }}
        {%- endfor %}
        endif
        {{note("Memorize that we've merged regular skeleton data of current frame")}}
		$merge_status_id = 1
	endif
endif
{{note("* $merge_status_id being 1 indicates we've already merged regular skeleton data for calling component in current frame")}}
if $merge_status_id == 1
    {{note("Try to get special skeleton data from current shader call")}}
    {{note("Make sure both vs-cb4 and vs-cb3 contain skeleton data")}}
    {{note("That's the only place where we can reliably get data for extra skeleton")}}
	if vs-cb4 == 3381.7777 && vs-cb3 == 3381.7777
        {{note("Pass constant buffer with special skeleton data to copy bones from")}}
		cs-cb8 = ref vs-cb3
        {{note("Initialize the pooled extra skeleton buffer of this instance if it hasn't been initialized yet")}}
        if #PoolExtraMergedSkeletonRW[$instance_id] == -1
            PoolExtraMergedSkeletonRW[$instance_id] = copy ResourceExtraMergedSkeletonRW
        endif
        {%- for instance in range(cfg.mod_merged_instance_count) %}
        {%- if loop.first %}
        if #PoolExtraMergedSkeletonRW[$instance_id] == {{ instance }}
        {%- else %}
        elif #PoolExtraMergedSkeletonRW[$instance_id] == {{ instance }}
        {%- endif %}
            {{note("Remember the instance id of the matched pool slot")}}
            $instance_id_{{ instance }} = $instance_id
            {{note("Pass buffer that gonna store special skeleton data of all components of this instance")}}
            cs-u6 = ResourceExtraMergedSkeletonRW{{ instance }}
            {{note("Set custom scale for skeleton, changing size of the entire model")}}
            $\WWMIv1\custom_mesh_scale = {{ '%0.2f'| format(skeleton_scale) }}
            {{note("Run Skeleton Merger CS to merge special skeleton data of current component into this instance's buffer")}}
            run = CustomShader\WWMIv1\SkeletonMerger
            {{note("Associate the merged buffer with the pool slot of this instance")}}
            PoolExtraMergedSkeletonRW[$instance_id] = ref ResourceExtraMergedSkeletonRW{{ instance }}
        {%- endfor %}
        endif
        {{note("Memorize that we've merged both regular and special skeleton data of current frame")}}
		$merge_status_id = 2
	endif
endif

{{note("Overrides textures via triggering [ResourceTextureX] sections by calling chechtextureoverride on ps-t slots")}}
[CommandListTriggerResourceOverrides]
{{note("Trigger texture sections to replace texture with matching hash")}}
{%- for slot_idx in range(cfg.max_ps_t + 1) %}
CheckTextureOverride = ps-t{{ slot_idx }}
{%- endfor %}
{{note("Trigger callbacks on bone data CBs to assign them filter_index")}}
{{note("These buffers cannot be replaced directly via `this` as their hash is widely used by many objects")}}
CheckTextureOverride = vs-cb3
CheckTextureOverride = vs-cb4

{{note("Overrides resources that are shared between VS calls")}}
[CommandListOverrideSharedResources]
{{note("Store pointer to original buffer to restore original context on cleanup")}}
ResourceBypassVB0 = ref vb0
{{note("Override resources to make draw calls use custom meshes")}}
ib = ResourceIndexBuffer
{% if unrestricted_custom_shape_keys and merged_object.shapekeys.vertex_count > 0 -%}
vb0 = ResourceShapeKeyedPosition
{%- else -%}
vb0 = ResourcePositionBuffer
{%- endif %}
vb1 = ResourceVectorBuffer
vb2 = ResourceTexcoordBuffer
{%- if "Color" in buffers.keys() %}
vb3 = ResourceColorBuffer
{%- endif %}
{{note("Use 16-bit blend buffer to support VG ids above 255 (up to 65535)")}}
vb4 = ResourceBlendBuffer_R16
{{note("Restore 16-bit format/offset of blend semantics in the game's vb4 declaration")}}
vb4->ElementFormat(ATTRIBUTE, 3) = R16G16B16A16_UINT
vb4->ElementFormat(ATTRIBUTE, 14) = R16G16B16A16_UINT
vb4->ElementFormat(ATTRIBUTE, 4) = R16G16B16A16_UNORM
vb4->ElementFormat(ATTRIBUTE, 15) = R16G16B16A16_UNORM
vb4->ElementOffset(ATTRIBUTE, 3) = 0
vb4->ElementOffset(ATTRIBUTE, 14) = 8
vb4->ElementOffset(ATTRIBUTE, 4) = 16
vb4->ElementOffset(ATTRIBUTE, 15) = 24
{{note("Pass merged skeleton of the current instance (identified by $instance_id) to bones data CB slots")}}
if vs-cb4 == 3381.7777
    vs-cb4 = ref PoolMergedSkeleton[$instance_id]
    if vs-cb3 == 3381.7777
        vs-cb3 = ref PoolExtraMergedSkeleton[$instance_id]
    endif
elif vs-cb3 == 3381.7777
    vs-cb3 = ref PoolMergedSkeleton[$instance_id]
endif
{%- if unrestricted_custom_shape_keys and merged_object.shapekeys.vertex_count > 0 %}
vb6 = null
{%- endif %}

{{note("Overrides resources that are shared between VS calls")}}
[CommandListCleanupSharedResources]
{{note("Restore original vb0 so we can use its hash to match next call")}}
vb0 = ref ResourceBypassVB0
if ResourceBlendBufferOverride !== null
    ResourceBlendBufferOverride = null
    ResourceMergedSkeletonOverride = null
    ResourceExtraMergedSkeletonOverride = null
endif

{%- for component in extracted_object.components %}
{%- set component_index = loop.index0 %}
{%- set is_path_complex = cfg.texture_mode == 'PATH' and cfg.hash_complex and path_complex and merged_object.components[component_index].objects | selectattr('material') | list | length > 0 %}

{{note("Override draw calls for Component %d" | format(component_index))}}
[TextureOverrideComponent{{ component_index }}]
hash = {{ extracted_object.vb0_hash }}
match_first_index = {{ component.index_offset }}
match_index_count = {{ component.index_count }}
{{note("Signal our mod that object is found on screen and we can start overriding it")}}
$object_detected = 1
if $mod_enabled
    {{note("Capture the instance id of the current draw call from the marked Mesh Data CB (vs-cb2 or vs-cb3)")}}
    if vs-cb2 == 3380.7777
        $instance_id = @vs-cb2
    elif vs-cb3 == 3380.7777
        $instance_id = @vs-cb3
    endif
    {{note("Initialize the pooled skeleton buffer of the current instance if it hasn't been initialized yet")}}
    if #PoolMergedSkeletonRW[$instance_id] == -1
        PoolMergedSkeletonRW[$instance_id] = copy ResourceMergedSkeletonRW
    endif
    {%- for instance in range(cfg.mod_merged_instance_count) %}
    {{note("Try to get skeleton data of instance %d from each call of the stack until merge status is 2 (see Constants for details)" | format(instance))}}
    if #PoolMergedSkeletonRW[$instance_id] == {{ instance }}
        if $merge_status_id_{{ component_index }}_{{ instance }} != 2
            {{note("Configure SkeletonMerger shader based on VG layout of current component")}}
            $\WWMIv1\vg_offset = {{ extracted_object.components[component_index].vg_offset }}
            $\WWMIv1\vg_count = {{ extracted_object.components[component_index].vg_count }}
            {{note("Pass current merge status to MergeSkeleton command list")}}
            $merge_status_id = $merge_status_id_{{ component_index }}_{{ instance }}
            {{note("Execute MergeSkeleton command list, updated merge status will be written to $merge_status_id")}}
            run = CommandListMergeSkeleton
            {{note("Remember merge status locally")}}
            $merge_status_id_{{ component_index }}_{{ instance }} = $merge_status_id
        endif
    endif
    {%- endfor %}
    {{note("Override draw call if we have a merged skeleton ready for the current instance")}}
    if #PoolMergedSkeleton[$instance_id] !== -1
    {%- if merged_object.components[component_index].objects | length > 0 %}
        {{note("Skip original draw call")}}
        handling = skip
        {%- if cfg.texture_mode == 'HASH' %}
        {{note("Trigger by-hash resource overrides")}}
        run = CommandListTriggerResourceOverrides
        {{note("Do by-slot resource overrides")}}
        run = CommandListOverrideSharedResources
        {%- for obj in merged_object.components[component_index].objects %}
        ; Draw {{ obj.name }}
        {%- if cfg.use_ini_toggles %}
        if {{ formatter.format_ini_drawvar(obj.name) }}
			drawindexed = {{ obj.index_count }}, {{ obj.index_offset }}, 0
        endif
        {%- else %}
        drawindexed = {{ obj.index_count }}, {{ obj.index_offset }}, 0
        {%- endif %}
        {%- endfor %}
        {%- elif cfg.texture_mode == 'SLOT' %}
        {{note("Trigger by-hash resource overrides")}}
        ; run = CommandListTriggerResourceOverrides
        {{note("Do by-slot resource overrides")}}
        run = CommandListOverrideSharedResources
        {%- if cfg.slot_complex %}
        {%- for group in slot_groups[component_index] %}
        {%- for node_group in group.node_groups %}
        {% if loop.first %}if{% else %}elif{% endif %}{% if cfg.match_dds_format == 'NONE' %}{% if cfg.ps_t_format_check %}{%- for input in node_group.inputs %}{% if input.format %} {{input.slot}}->format == {{input.format.value}} &&{% endif %}{%- endfor %}{% endif %}{% if cfg.rabbitfx %} ps == 1718.1 &&{% endif %} 1{% else %}{%- for input in node_group.inputs %} {{input.slot}} == {{input.filter_index}} &&{% if cfg.ps_t_format_check and input.format %} {{input.slot}}->format == {{input.format.value}} &&{% endif %} {%- endfor %} {% if cfg.rabbitfx %}ps == 1718.1{% else %}1{% endif %}{% endif %}
            {%- for input in node_group.inputs %}
            {{input.slot}} = ref ResourceTexture{{ input.resource_name }}
            {%- endfor %}
        {%- endfor %}
        endif
        {%- for obj in group.objects %}
        ; Draw {{ obj.name }}
        {%- if cfg.use_ini_toggles %}
        if {{ formatter.format_ini_drawvar(obj.name) }}
			drawindexed = {{ obj.index_count }}, {{ obj.index_offset }}, 0
        endif
        {%- else %}
		drawindexed = {{ obj.index_count }}, {{ obj.index_offset }}, 0
        {%- endif %}
        {%- endfor %}
        {%- endfor %}
        {%- else %}
        {%- if merged_object.components[component_index].material %}
        {%- for node_group in merged_object.components[component_index].material.node_groups %}
        {% if loop.first %}if{% else %}elif{% endif %}{% if cfg.match_dds_format == 'NONE' %}{% if cfg.ps_t_format_check %}{%- for input in node_group.inputs %}{% if input.format %} {{input.slot}}->format == {{input.format.value}} &&{% endif %}{%- endfor %}{% endif %}{% if cfg.rabbitfx %} ps == 1718.1 &&{% endif %} 1{% else %}{%- for input in node_group.inputs %} {{input.slot}} == {{input.filter_index}} &&{% if cfg.ps_t_format_check and input.format %} {{input.slot}}->format == {{input.format.value}} &&{% endif %} {%- endfor %} {% if cfg.rabbitfx %}ps == 1718.1{% else %}1{% endif %}{% endif %}
            {%- for input in node_group.inputs %}
            {{input.slot}} = ref ResourceTexture{{ input.resource_name }}
            {%- endfor %}
        {%- endfor %}
        endif
        {%- endif %}
        {%- for obj in merged_object.components[component_index].objects %}
        ; Draw {{ obj.name }}
        {%- if cfg.use_ini_toggles %}
        if {{ formatter.format_ini_drawvar(obj.name) }}
			drawindexed = {{ obj.index_count }}, {{ obj.index_offset }}, 0
        endif
        {%- else %}
		drawindexed = {{ obj.index_count }}, {{ obj.index_offset }}, 0
        {%- endif %}
        {%- endfor %}
        {%- endif %}
        {%- elif cfg.texture_mode == 'PATH' %}
        {%- if is_path_complex %}
        {{note("Do by-slot resource overrides")}}
        run = CommandListOverrideSharedResources
        {{note("Save original ps-t textures once so they can be restored after each draw call")}}
        run = CommandListBackupTexture
        {%- for group in path_complex.draw_groups[component_index] %}
        {{note("Pick the right texture override for this material group")}}
        $texture_component{{ component_index }}_count = {{ group.group_idx }}
        {{note("Trigger by-hash resource overrides")}}
        run = CommandListTriggerResourceOverrides
        {%- for obj in group.objects %}
        ; Draw {{ obj.name }}
        {%- if cfg.use_ini_toggles %}
        if {{ formatter.format_ini_drawvar(obj.name) }}
			drawindexed = {{ obj.index_count }}, {{ obj.index_offset }}, 0
        endif
        {%- else %}
		drawindexed = {{ obj.index_count }}, {{ obj.index_offset }}, 0
        {%- endif %}
        {%- endfor %}
        {{note("Restore original textures")}}
        run = CommandListRestoreTexture
        {%- endfor %}
        $texture_component{{ component_index }}_count = -1
        {%- else %}
        {{note("Trigger by-hash resource overrides")}}
        run = CommandListTriggerResourceOverrides
        {{note("Do by-slot resource overrides")}}
        run = CommandListOverrideSharedResources
        {%- for obj in merged_object.components[component_index].objects %}
        ; Draw {{ obj.name }}
        {%- if cfg.use_ini_toggles %}
        if {{ formatter.format_ini_drawvar(obj.name) }}
			drawindexed = {{ obj.index_count }}, {{ obj.index_offset }}, 0
        endif
        {%- else %}
		drawindexed = {{ obj.index_count }}, {{ obj.index_offset }}, 0
        {%- endif %}
        {%- endfor %}
        {%- endif %}
        {%- endif %}
        {{note("Restore required parts of original context")}}
        run = CommandListCleanupSharedResources
    {%- else %}
        {{note("Skip original draw call")}}
        handling = skip
        {{note("Trigger by-hash resource overrides")}}
        ; run = CommandListTriggerResourceOverrides
        {{note("Do by-slot resource overrides")}}
        ; run = CommandListOverrideSharedResources
        ; Draw skipped: No matching custom components found
        {{note("Restore required parts of original context")}}
        ; run = CommandListCleanupSharedResources
    {%- endif %}
    endif
endif

{%- endfor %}

; Shading: Textures -------------------------

{%- if cfg.texture_mode == 'SLOT' and cfg.match_dds_format == 'NONE' and slot_textures %}
{%- for texture in slot_textures %}

[ResourceTexture{{ texture.resource_name }}]
filename = Textures/{{ texture.dds_export_name }}
{%- endfor %}
{%- endif %}

{%- if cfg.texture_mode == 'SLOT' and cfg.match_dds_format == 'LESS' and slot_textures %}
{%- for component in merged_object.components %}
{%- set component_idx = loop.index0 %}
{%- for mf in component.match_formats %}

[TextureOverrideComponent{{ component_idx }}{{ mf.match_format.name }}]
match_first_index = {{ extracted_object.components[component_idx].index_offset }}
match_index_count = {{ extracted_object.components[component_idx].index_count }}
match_priority = 100
match_format = {{ mf.match_format.name }}
filter_index = {{ mf.filter_index }}
